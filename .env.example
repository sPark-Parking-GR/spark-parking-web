# Session
# Secret used to encrypt the httpOnly admin session cookie. MUST be >= 32 characters.
SESSION_SECRET=

# Maps
MAP_PROVIDER=google    # google | mapbox
GOOGLE_MAPS_KEY=
# Client-safe map config (exposed in the browser bundle)
NEXT_PUBLIC_MAP_PROVIDER=google    # google | mapbox
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID    # cloud-styled map id; required for AdvancedMarker
NEXT_PUBLIC_MAPBOX_TOKEN=

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
